{
  "name": "ladeplanner",
  "version": "0.1.0",
  "private": true,
  "description": "Zielzentrierte Ladeplanung fuer E-Autos: Laden am Zielort, nicht auf der Autobahn.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:postgis": "psql \"$DATABASE_URL\" -f prisma/sql/postgis.sql",
    "import:bnetza": "tsx scripts/import-bnetza.ts",
    "import:ocm": "tsx scripts/import-ocm.ts",
    "import:ocpdb": "tsx scripts/import-ocpdb.ts",
    "poll:realtime": "tsx scripts/poll-realtime.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
