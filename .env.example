# Postgres (Neon oder Supabase), Konzept §6
DATABASE_URL="postgresql://user:pass@host:5432/ladeplanner?schema=public"

# Ladepunkt-Quelle: "postgis" nutzt die DB, sonst Seed-Daten (M2)
# CHARGER_SOURCE="postgis"

# Open Charge Map API-Key fuer den Import (M2, Konzept §5.1)
# https://openchargemap.org/site/develop/api
# OCM_API_KEY=""

# Mobilithek DE-weit (AFIR Dynamic, gebrokert, mTLS) — Konzept §5.1
# Maschinenzertifikat: Mobilithek stellt es aus (.p12 per Mail, Passwort per
# SMS). Mit `openssl pkcs12 -in <p12> -out pem` in Cert+Key aufteilen.
# Zertifikat/Schluessel je als Datei-Pfad ODER direkt PEM-Inhalt.
# MOBILITHEK_CERT="/pfad/zum/cert.pem"
# MOBILITHEK_KEY="/pfad/zum/key.pem"
# CA (Serverkette prod-mdp.m2m.de) ist fest eingebaut; nur setzen zum Ueberschreiben.
# MOBILITHEK_CA="/pfad/zur/ca.pem"
# Abonnement (Road B.V. "Road Public Network: AFIR Dynamic Data", DATEX II v3 JSON)
# MOBILITHEK_DYNAMIC_SUBSCRIPTION_ID="1033003052646182912"

# Live-Belegung on-demand (Konzept §5.1). Mehrere Keys = Fallback-Kette
# (TomTom, dann Google); ohne Key: "Status unbekannt".
# TomTom: https://developer.tomtom.com  (kostenloses Kontingent)
# TOMTOM_API_KEY=""
# Google Places (New): https://console.cloud.google.com (Places API New aktivieren)
# GOOGLE_PLACES_API_KEY=""
# HERE (Backup, folgt): https://developer.here.com
# HERE_API_KEY=""

# Google Directions API — ETA mit Live-Verkehr (M5, Konzept §6.3)
# GOOGLE_DIRECTIONS_API_KEY=""

# ntfy.sh Topic fuer Push (M4, Konzept §6) — schwer erratbaren Namen waehlen
# NTFY_TOPIC="ladeplanner-markus-7f3q"

# Schutz der Cron-Endpunkte. Wenn gesetzt, muss der Aufruf
# "Authorization: Bearer <secret>" mitbringen (ofelia/Vercel Cron sendet das).
# CRON_SECRET=""

# Hetzner-Deploy (eigener Server, docker-compose.yml + eigenes Caddy):
# DOMAIN="ladeplanner.deine-domain.de"
# ACME_EMAIL="du@example.com"

# Co-Host auf bestehendem Server (docker-compose.cohost.yml): Docker-Netz des
# vorhandenen Stacks, in das sich Ladeplanner haengt. Default: brewlog_default.
# SHARED_NETWORK="brewlog_default"
